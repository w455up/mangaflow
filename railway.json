{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "source": {
        "directory": "backend"
      },
      "config": {
        "healthcheck": "/health",
        "env": {
          "PYTHONUNBUFFERED": "1",
          "PORT": "8000"
        }
      }
    },
    "frontend": {
      "source": {
        "directory": "frontend"
      },
      "config": {
        "healthcheck": null
      }
    }
  }
}



